{
  "name": "@ufd/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@ufd/types": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.3.3",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/websockets": "11.2.8",
    "fastify": "5.12.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ioredis": "6.0.0",
    "jose": "6.2.14",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@ufd/config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "@types/node": "24.19.2",
    "@nestjs/testing": "11.2.8"
  }
}
